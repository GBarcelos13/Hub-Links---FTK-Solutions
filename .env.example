# ============================================================
# VARIÁVEIS DO CLIENTE (Vite — prefixo VITE_ obrigatório)
# Copie este arquivo como .env e preencha os valores abaixo
# ============================================================

# Supabase — Project URL e chave pública (anon)
# Encontre em: supabase.com/dashboard/project/<id>/settings/api
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# Web3Forms — formulário de feedback
# Cadastre-se em web3forms.com com seu e-mail e copie a Access Key
VITE_WEB3FORMS_KEY="<web3forms-access-key>"

# ============================================================
# SECRETS DO SERVIDOR — Supabase Edge Functions
# NÃO vão para o .env do Vite. Configure via:
#   supabase secrets set KEY=value
# Ou no painel: supabase.com/dashboard/project/<id>/functions
# ============================================================

# Stripe
# STRIPE_SECRET_KEY=sk_live_...           ← API Keys no Stripe Dashboard
# STRIPE_WEBHOOK_SECRET=whsec_...         ← Criado ao registrar o webhook
# STRIPE_PRICE_PRO=price_...             ← Price ID do plano Pro
# STRIPE_PRICE_ELITE=price_...           ← Price ID do plano Elite

# URL pública do app (sem barra no final)
# APP_URL=https://seudominio.com

# Supabase (server-side, com service role)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>  ← NUNCA exponha no cliente!
