{
  "manifest_version": 3,
  "name": "HUB Links – Salvar Link",
  "version": "1.0.0",
  "description": "Salve o link da aba atual no seu HUB Links com 1 clique.",
  "permissions": ["storage", "activeTab", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Salvar no HUB Links"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
